#getRecipientRecords function - prompt user to enter recipient records 
def getRecipientRecords():
  
    #set up an empty list to fill with individual recipient dictionaries
    recordList = []
    
    #display record input instructions to user   
    displayInstructions()
    
    print(f"Paste Recipient Records Below. Type 'END' to Finish: \n\n")
    
    #prompt user to enter recipient records

    while True:

        #prompt user
        record = input('')
        if record == 'END':
            break
        #split the record into 5 list elements
        record = record.split('\t')
        
        #validate the records
        #and store the result
        record = validateListLen(record)

        #convert list into dictionary
        recipientDict = dict(
            #assign keys to list indexes
            first= record[0], 
            middle= record[1], 
            last= record[2], 
            degreeType= record[3], 
            honorType= record[4] )
        
        #validate the format for each dict key
        validateRecord(recipientDict)
        
        #Did the dict pass the validation gauntlet?
        #add that dictionary to the master list
        recordList.append(recipientDict)

    return recordList
 
    
#validateRecordListLen - validate the length of each list
def validateListLen(list):
    while len(list) != COL:
        
        #test for excess fields
        
        if len(list) > COL:
            #display error message
            print (f'{list} has more than {COL} fields.\n Please reenter the record to have {COL} fields, each seperated by a tab.\n')
           
            #prompt user for corrected record
            list = input(f'Corrected Record: ')

            #resplit for the recount
            list = list.split('\t')
            
        #test for not enough fields
    
        elif len(list) < COL:
            
            #display error message
            print (f'{list} has less than {COL} fields.\n Please reenter the record to have {COL} fields, each separated by a tab:')
           
            #prompt user for corrected record
            list = input(f'Corrected Record: ')
           
            #resplit for the recount
            list = list.split('\t')
            
        
    return list
    

