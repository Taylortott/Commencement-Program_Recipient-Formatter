#validateRecordListLen - validate the length of each list
def validateListLen(list):
#validate list length
while len(list) != COL:
#test for excess fields
if len(list) > COL:
#display error message
print (f'{list} has more than {COL} fields.\n Please reenter the record
to have {COL} fields, each seperated by a tab.\n')
#prompt user for corrected record
list = input(f'Corrected Record: ')
#resplit for the recount
list = list.split('\t')
#test for not enough fields
elif len(list) < COL:
#display error message
print (f'{list} has less than {COL} fields.\n Please reenter the record
to have {COL} fields, each separated by a tab:')
#prompt user for corrected record
list = input(f'Corrected Record: ')
#resplit for the recount
list = list.split('\t')
#once the list has the correct amount of fields, return the list
return list
