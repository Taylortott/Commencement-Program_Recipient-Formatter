def getRecipientRecords():
    
    """
   Prompt user to enter recipient records

   Parameters:
       none

   Returns:
       recordList(list): a list containing all recipient dicts
   """
    
    #display input instructions to user   
    displayInstructions()

    #set up an empty list to fill with individual records
    #items will be added to this after records have been converted into dictionaries
    recordList = []
        
    #prompt user to enter recipient records

    #mechanism for accepting multiline input
    while True:

        #prompt user
        record = input('')
        print('')

        #terminate condition
        if record == 'END':
            break

        #split the record into 5 list elements
        record = record.split('\t')
        
        #validate the records field length and store the returned result
        record = validateListLen(record)

        #convert list into dictionary
        recipientDict = dict(
            #assign keys to list indexes
            first= record[0], 
            middle= record[1], 
            last= record[2], 
            degreeType= record[3], 
            honorType= record[4] )
        
        #validate the format for each dict key
        validateRecordDict(recipientDict)
        
        #Did the dict pass the validation gauntlet?
        #add that dictionary to the master list
        recordList.append(recipientDict)

    #pass the final list back to main()
    return recordList


def validateListLen(recipient):
    
    """
   Validate the length of each list

   Parameters:
       recipient(list) - the initial recipient record input

   Returns:
       recipirnt(list): a list that contains the informatioon for an indivisual recipient
   """

    if len(recipient) != RECORD_FIELDS_COUNT:
        print('\n---------- X Correction Needed ----------')
        #validate list length
        while len(recipient) != RECORD_FIELDS_COUNT:
            
            #test for excess fields
            
            invalidEntry = (" ".join([str(item) for item in recipient]))
        
            if len(recipient) > RECORD_FIELDS_COUNT:
                #display error message
                print('')
                print (f"'{invalidEntry}' has too much information.")
                print('')
                print ('Please reenter the record to have only one of each:')
                print('- first name')
                print('- middle name')
                print('- last name')
                print('- degree')
                print('- honors recieved')
                print('Make sure each piece is separated by a tab.')
                print('')
           
                #prompt user for corrected record
                recipient = input('Enter the corrected record below:\n ')

                #resplit for the recount
                recipient = recipient.split('\t')
            
            #test for not enough fields
    
            elif len(recipient) < RECORD_FIELDS_COUNT:
            
                #display error message
                print (f"'{invalidEntry}' is incomplete.")
                print('')
                print ('Please reenter the record to have each of the following:')
                print('- first name')
                print('- middle name')
                print('- last name')
                print('- degree')
                print('- honors recieved')
                print('Make sure each piece is separated by a tab.')
                print('')
                #prompt user for corrected record
                recipient = input('Enter the corrected record below:\n')
           
                #resplit for the recount
                recipient = recipient.split('\t')
        print('\n---------- ✓ Correction Accepted ----------\n')
    #once the list has the correct amount of fields, return the list
    return recipient
    

def validateRecordDict(recordDict):
    
    """
    Validate each element of the record dict key and allow for correction

    Parameters:
        recordDict (dict):  the dict of an individual recipient's info

    Returns:
        recordDict (dict): a corrected or original dict of an individual recipient info
    """
     
    #make a copy of the initial record 
    originalRecord = recordDict.copy()
    
    #run the dict validation gauntlet
    
    #check for blank fields
    checkBlankFields(recordDict)
    
    #check for name capitalization
    checkNameCapitalization(recordDict)

    #validate degree types
    validateDegreeTypes(recordDict)
    
    #validate honor type
    validateHonorTypes(recordDict)
    
    #compare the initial version to the corrected version
    if originalRecord != recordDict:
        #convert dict to str
        originalRecord  = convertRecordDictToStr(originalRecord)
        #strike through the old record
        print(strike(originalRecord))
        print(convertRecordDictToStr(recordDict))
        print('\nContinue entering recipients or enter END to begin reformatting:\n')
    
    return recordDict


def convertRecordDictToStr(record):
    
    """
    Convert dict to a str

    Parameters:
        record (dict): the dict of an individual recipient's info'

    Returns:
        record (str): a recipient's info, ready for print
    """
    
    #format the record by converting the dict into a str
    record  = record['first'] + ' '+ record['middle'] + ' '+ record['last'] + ' '+ record['degreeType'] + ' '+ record['honorType']

    return record


def strike(text):
    
    """
    Adds a strike through to each word in a str

    Parameters:
        text (str) : the dict of an individual recipient's info converted to a str

    Returns:
        result (str): a recipient's info struck through
    """
    
    result = ''
    for i in text:
        result = result + i + '\u0336'
    return result


def checkBlankFields(recordDict):
    
    """
    Checks for blank fields in a dict and prompts the user to fill them

    Parameters:
        recordDict (dict) : an individual recipient info

    Returns:
        recordDict (dict): a corrected or original dict of an individual recipient info
    """
    
    #check each field (except for middle name)for blanks
    if (recordDict['first'] == '' or recordDict['first'] == ' ') or (recordDict['last'] == '' or recordDict['last'] == ' ') or (recordDict['degreeType'] == '' or recordDict['degreeType'] == ' ') or (recordDict['honorType'] == '' or recordDict['honorType'] == ' '):
        #print error message
        print('\n---------- X Correction Needed ----------')
        #enter loop
        #convert dict to str for print
        strRecord = convertRecordDictToStr(recordDict)
        print(f"\nThe record for '{strRecord}' is incomplete as one or more fields are empty.")
        #enter loops
        #first name field
        while recordDict['first'] == '' or recordDict['first'] == ' ':
            print("\nPlease enter the following to complete this record:\n")
            #let the user correct the input
            recordDict['first'] = input("First Name: ") 
        #last name field
        while recordDict['last'] == '' or recordDict['last'] == ' ':
            print("\nPlease enter the following to complete this record:\n")
            #let the user correct the input
            recordDict['last'] = input("Last Name: ")
       #degree type field
        while recordDict['degreeType'] == '' or recordDict['degreeType'] == ' ':
          #display options
          print("\nPlease enter one of the following degree types to complete this record:\n")
          #display a table
          print('Degree Level\t|\tDegree Type')
          print('---------------------------------')
          print('Bachelor\t|\t' + ', '.join(DEGREE_TYPE['Bachelor']))
          print('Associate\t|\t' + ', '.join(DEGREE_TYPE['Associate']))
          print('Certificate\t|\t' + ', '.join(DEGREE_TYPE['Certificate']))
          print('')
          #let the user correct the input
          recordDict['degreeType'] = input("Degree Type: ")
      #honor type field
        while recordDict['honorType'] == '' or recordDict['honorType'] == ' ':
            #let the user correct the input
            recordDict['honorType'] = input("Honors Earned: ")  
        print('\n---------- ✓ Correction Accepted ----------\n')
 
    #exit input validation loops

    #return dict that has passed inspection / been updated
    return recordDict


def checkNameCapitalization(recordDict):
    
    """
    Checks the first, middle, and last recipient dict keys for capitalization

    Parameters:
        recordDict (dict) : an individual recipient info

    Returns:
        recordDict (dict): a corrected or original dict of an individual recipient info
    """
    
    #validate name capitalization for
    # first, middle, and last

    #check first, middle, and last dict keys
    if recordDict['first'][0].isupper() == False or (recordDict['middle'] != '' and recordDict['middle'][0].isupper() == False) or recordDict['last'][0].isupper() == False:
        #display error message
        print('\n---------- X Correction Needed ----------')
        invalidRecord = convertRecordDictToStr(recordDict)
        print(f"'{invalidRecord}' has incorrect capitalization.\n\nPlease correct the following:")
        #enter loop
        #correct first name
        while recordDict['first'][0].isupper() == False:
            #let the user correct the input
            recordDict['first'] = input(f'\nFirst Name\nCurrently: {recordDict['first']}\nCorrected: ')
            #correct middle name
        while recordDict['middle'] != '' and recordDict['middle'][0].isupper() == False:
            #let the user correct the input
            recordDict['middle'] = input(f'\nMiddle Name\nCurrently: {recordDict['middle']}\nCorrected: ')
            #correct last name
        while recordDict['last'][0].isupper() == False:
            #let the user correct the input
            recordDict['last'] = input(f'\nLast Name\nCurrently: {recordDict['last']}\nCorrected: ')
        print('\n---------- ✓ Correction Accepted ----------\n')
        
        #exit loops
        
    #return dict that has passed inspection / been updated
    return recordDict


def validateDegreeTypes(recordDict):
    
    """
    Checks the degreeType dict keys for valid degrees

    Parameters:
        recordDict (dict) : an individual recipient info

    Returns:
        recordDict (dict): a corrected or original dict of an individual recipient info
    """
    
    #see if the recipeints degree type is in the recognized master list of degree types
    #if the degree type input is not in any of dict lists (which is why we use AND here), then we enter the loop
    if recordDict['degreeType'] not in DEGREE_TYPE['Bachelor'] and recordDict['degreeType'] not in DEGREE_TYPE['Associate'] and recordDict['degreeType'] not in DEGREE_TYPE['Certificate']: 
        while recordDict['degreeType'] not in DEGREE_TYPE['Bachelor'] and recordDict['degreeType'] not in DEGREE_TYPE['Associate'] and recordDict['degreeType'] not in DEGREE_TYPE['Certificate']: 
            print('\n---------- X Correction Needed ----------')
            invalidRecord = convertRecordDictToStr(recordDict)
            print(f"Please correct the following for '{invalidRecord}':\n")
            print(f"'{recordDict['degreeType']}' is not a degree currently offered at Eastern Arizona College.\n") 
            print('Please choose one of the following:')
            print('Bachelor:\t' + ', '.join(DEGREE_TYPE['Bachelor']))
            print('Associate:\t' + ', '.join(DEGREE_TYPE['Associate']))
            print('Certificate:\t' + ', '.join(DEGREE_TYPE['Certificate']))
            print('')
            recordDict['degreeType'] = input('Enter Degree: ')
        if recordDict['degreeType'] in DEGREE_TYPE['Bachelor'] and recordDict['degreeType'] in DEGREE_TYPE['Associate'] and recordDict['degreeType'] in DEGREE_TYPE['Certificate']: 
            print('\n---------- ✓ Correction Accepted ----------\n')       
    return recordDict


def validateHonorTypes(recordDict):
    
    """
    Checks the honorType dict keys for valid honor types

    Parameters:
        recordDict (dict) : an individual recipient info

    Returns:
        recordDict (dict): a corrected or original dict of an individual recipient info
    """
    
    #see if the recipeints honor type is not in the recognized master list of degree types
    if recordDict['honorType'] not in HONOR_TYPE:
      print('\n---------- X Correction Needed ----------')
      while recordDict['honorType'] not in HONOR_TYPE: 
          print(f"'{recordDict['honorType']}' is not a valid honor type.")
          print('')
          print('Please choose one of the following:\n')
          for item in HONOR_TYPE:
              print('- ' + item)
          print('')
          recordDict['honorType'] = input('Update Honor Type: ')
      print('\n---------- ✓ Correction Accepted ----------\n')
      
    return recordDict


def formatList(records):
    
    """
    Begins formatting and sorting the given input into a reformatted list by utilizing nested loops

    Parameters:
        records (list) : a list of dicts for each recipient

    Returns:
        formattedList (list): the final reformatted and sorted list
    """
    
    #create an empty list
    formattedList =[]
    
    #get a unique list of degrees to use in the formatting loops
    uniqueDegreeList = getUniqueDegreeTypes(records)
   
    #use nested loops to sort by
        #degree level
            #degree type
                #recipients
                    #find recipients that match degree type
                    #sort those recipients
                    #print those recipients
    
    #outer loop - degree level --  ex. Bachelor
    #level automatically has zero value, it changes value by going through the degree level constant list
    for level in DEGREE_LEVEL:

        #inner loop 1 = degree type -- ex. BS
        #the value that the level variable gained in the outer loop is passed as a key to the degree type constant dictionary of lists in inner loop 1
        #the variable degreeType automatically has no value, it changes value by going through the degree types stored in the degree types constant dictionary lists accessed through the level variable key
        
        for degreeType in uniqueDegreeList[level]:
            #pass degreeType to get the proper heading and store the returned value as heading
            heading = getFullDegreeHeading(degreeType)
            formattedList.append(heading)

            #create an empty list of recipients for the current degree type, which will be filled in the next loop
            degreeRecipients = []

            #inner loop 2.1 = get the recipients
            for recipient in records:
                #scan through the list to find items that match the criteria given from Inner Loop 1's degreeType variable
                if recipient.get('degreeType') == degreeType:
                    #add matches to the current degree's list
                    degreeRecipients.append(recipient)

            #got all of the recipients that match the criteria? NOW sort them by last name
            sortedDegreeRecipients = sortRecipientList(degreeRecipients)

            #inner loop 2.2 = add the sorted list of selected recipients to the final formatted list ONCE
            for recipient in sortedDegreeRecipients:
                #get the full formatted name for each recipient
                recipient = (f'{getHonorSymbol(recipient)} {getFullName(recipient)}')
                
                #add that formatted name to the master formatted list
                formattedList.append(f'\t{recipient}')           
    #after ALL loops have concluded, return list to main()          
    return formattedList


def getUniqueDegreeTypes(recipientList):
    
    """
    Receive multiple degree types and produce a sorted list with no duplicates

    Parameters:
        recipientList (list) : a list of dicts for each recipient

    Returns:
        uniqueDegreeDict (dict): master dict list with unique degree types for each degree level
    """
    
    #empty degree lists to be filled in through iteration
    certificates = []
    associateDegrees = []
    bachelorDegrees = []
    
    #identify the degree types and add to list(s)
    #iterate through each recipient in the list
    for recipient in recipientList:
        #check if the value currently exists in the list or not
        #bachelor
        if recipient['degreeType'][0] == 'b' or recipient['degreeType'][0] == 'B':
            #detect and prevent adding of duplicates
            if recipient['degreeType'] not in bachelorDegrees:
                bachelorDegrees.append(recipient['degreeType'])
        #associate
        elif recipient['degreeType'][0] == 'a' or recipient['degreeType'][0] == 'A':
            #detect and prevent adding of duplicates
            if recipient['degreeType'] not in associateDegrees:
                associateDegrees.append(recipient['degreeType'])
        #certificate
        elif recipient['degreeType'][0] == 'c' or recipient['degreeType'][0] == 'C':
            #detect and prevent adding of duplicates
            if recipient['degreeType'] not in certificates:
                certificates.append(recipient['degreeType'])
    
    #exit the loop

    #sort each degree level lists alphabetically
    bachelorDegrees.sort()
    associateDegrees.sort()
    
    #certificates don't need to be sorted as there is only one type
    
    #add sorted lists to master dict list
    uniqueDegreeDict = dict(
        #assign keys to list indexes
        Bachelor = bachelorDegrees,
        Associate = associateDegrees,
        Certificate = certificates)

    #return sorted unique list to formatlist() to use in runs
    #so that only provided values are used instead of all possible values
    return uniqueDegreeDict


def getFullDegreeHeading(degreeType):
    
    """
    Receive one degree type and convert it into the full proper degree heading
    
    Parameters:
        degreeType (str): the degree type abbr

    Returns:
        heading(str): the full proper degree heading
    """

    #bachelor's ['BA', 'BS']
    if degreeType == 'BA':
        heading = 'Bachelor of Arts'
        return heading
    elif degreeType == 'BS':
        heading = 'Bachelor of Science'
        return heading

    #associate's ['AA', 'AAS','ABus', 'AGS','AS'],
    elif degreeType == 'AA':
        heading = 'Associate of Arts'
        return heading
    elif degreeType == 'AAS':
        heading = 'Associate of Applied Science'
        return heading
    elif degreeType == 'ABus' or degreeType == 'Abus':
        heading = 'Associate of Business'
        return heading
    elif degreeType == 'AGS':
        heading = 'Associate of General Studies'
        return heading
    elif degreeType == 'AS':
        heading = 'Associate of Science'
        return heading

    #certificate
    elif degreeType == 'Certificate':
        heading = 'Certificates'
        return heading

    #unrecognized degree
    else:
        print('Degree Type Not Recognized')

def sortRecipientList(degreeRecipients):
    
    """
    Sort recipients in a dict list alphabetically by last name and then return the list
    
    Parameters:
        degreeRecipients (list):  a list of dicts for each recipient

    Returns:
        sortedDegreeRecipients (list): dict list sorted alphabetically by last name
    """
    
    #sort the recipients in the dict list by last name
    sortedDegreeRecipients = sorted(degreeRecipients, key = lambda d: d['last'])
    
    return sortedDegreeRecipients


def getFullName(record):
    
    """
    Concatenate first, middle, and last name together
    
    Parameters:
        record (dict):  an individual recipeint's info

    Returns:
        fullName (str): recipient's full name
    """
    
    #concatenate first, middle, and last name into a full name
    if record['middle'] == ' ':
        fullName = record['first'] + ' ' + record['last']
    else:
        fullName = record['first'] + ' ' + record['middle'] + ' ' + record['last']
    
    return fullName


def getHonorSymbol(recipient):
    
    """
    Determine what honor symbol the recipient gets
    
    Parameters:
        recipient (dict): the info for an indicidual recipient

    Returns:
        honorType(str): Corresponding honor type symbol
    """
    
    #find what honor symbol matches the given honor type
    
    if recipient['honorType'] == 'No Honors' or recipient['honorType'] == 'no honors':
        honorType = NO_HONORS
    elif recipient['honorType'] == 'Honors' or recipient['honorType'] == 'honors':
        honorType = HONORS
    elif recipient['honorType'] == 'High Honors' or recipient['honorType'] == 'high honors':
        honorType = HIGH_HONORS
    elif recipient['honorType'] == 'Highest Honors' or recipient['honorType'] == 'highest honors':
        honorType = HIGHEST_HONORS

    #return appropriate honor symbol
    return honorType
    
    
