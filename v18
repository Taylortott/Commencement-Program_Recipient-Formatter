#getRecipientRecords function - prompt user to enter recipient records 
def getRecipientRecords():
    
    #display input instructions to user   
    displayInstructions()

    #set up an empty list to fill with individual records
    #items will be added to this after records have been converted into dictionaries
    recordList = []
        
    #prompt user to enter recipient records

    #mechanism for accepting multiline input
    while True:

        #prompt user
        record = input('')

        #terminate condition
        if record == 'END':
            break

        #split the record into 5 list elements
        record = record.split('\t')
        
        #validate the records field length and store the returned result
        record = validateListLen(record)

        #convert list into dictionary
        recipientDict = dict(
            #assign keys to list indexes
            first= record[0], 
            middle= record[1], 
            last= record[2], 
            degreeType= record[3], 
            honorType= record[4] )
        
        #validate the format for each dict key
        validateRecordDict(recipientDict)
        
        #Did the dict pass the validation gauntlet?
        #add that dictionary to the master list
        recordList.append(recipientDict)

    #pass the final list back to main()
    return recordList


#validateRecordListLen - validate the length of each list
def validateListLen(recipient):

    #validate list length
    while len(recipient) != RECORD_FIELDS_COUNT:
        
        #test for excess fields
        
        if len(recipient) > RECORD_FIELDS_COUNT:
            #display error message
            print('')
            print (f'{recipient} has too much information.')
            print('')
            print ('Please reenter the record to have only one of each:')
            print('- first name')
            print('- middle name')
            print('- last name')
            print('- degree')
            print('- honors recieved')
            print('Make sure each piece is separated by a tab:.')
            print('')
           
            #prompt user for corrected record
            recipient = input('Enter the corrected record below:\n ')

            #resplit for the recount
            recipient = recipient.split('\t')
            
        #test for not enough fields
    
        elif len(recipient) < RECORD_FIELDS_COUNT:
            
            #display error message
            print (f'{recipient} is incomplete.')
            print('')
            print ('Please reenter the record to have each of the following:')
            print('- first name')
            print('- middle name')
            print('- last name')
            print('- degree')
            print('- honors recieved')
            print('Make sure each piece is separated by a tab:')
           
            #prompt user for corrected record
            recipient = input('Enter the corrected record below:\n ')
           
            #resplit for the recount
            recipient = recipient.split('\t')

    #once the list has the correct amount of fields, return the list
    return recipient
    

#validateRecordDict function - validate each element of the record dict key and allow for correction
def validateRecordDict(recordDict):
     
    #make a copy of the initial record 
    originalRecord = recordDict.copy()
    
    #run the dict validation gauntlet
    
    #check for blank fields
    checkBlankFields(recordDict)
    
    #check for name capitalization
    checkNameCapitalization(recordDict)

    #validate degree types
    validateDegreeTypes(recordDict)
    
    #validate honor type
    validateHonorTypes(recordDict)
    
    #compare the initial version to the corrected version
    if originalRecord != recordDict:
        #display update message if changes were made
        #convert dict to str
        originalRecord  = convertRecordDictToStr(originalRecord)
        #strike through the old record
        print(strike(originalRecord))
        print(convertRecordDictToStr(recordDict))
        print('\nContinue entering recipients or enter END to begin reformatting:\n')
    
    return recordDict


#printRecordDict ( ) - convert dict to a str
def convertRecordDictToStr(record):
    #format the record by converting the dict into a str
    record  = record['first'] + ' '+ record['middle'] + ' '+ record['last'] + ' '+ record['degreeType'] + ' '+ record['honorType']

    return record


#strike( ) - adds a strike through to each word in a str
def strike(text):
    result = ' '
    for i in text:
        result = result + i + '\u0336'
    return result


#checkBlankFields() - checks for blank fields and prompts user to fill them
def checkBlankFields(recordDict):
    
    #check each field (except for middle name)for blanks
    if (recordDict['first'] == '' or recordDict['first'] == ' ') or (recordDict['last'] == '' or recordDict['last'] == ' ') or (recordDict['degreeType'] == '' or recordDict['degreeType'] == ' ') or (recordDict['honorType'] == '' or recordDict['honorType'] == ' '):
        #print error message
        #convert dict to str for print
        strRecord = convertRecordDictToStr(recordDict)
        print(f"\nThe record for '{strRecord}' is incomplete as one or more fields are empty.")
        #enter loops
        #first name field
        while recordDict['first'] == '' or recordDict['first'] == ' ':
            print("\nPlease enter the following to complete this record:\n")
            #let the user correct the input
            recordDict['first'] = input("First Name: ") 
        #last name field
        while recordDict['last'] == '' or recordDict['last'] == ' ':
            print("\nPlease enter the following to complete this record:\n")
            #let the user correct the input
            recordDict['last'] = input("Last Name: ")
       #degree type field
        while recordDict['degreeType'] == '' or recordDict['degreeType'] == ' ':
          #display options
          print("\nPlease enter one of the following degree types to complete this record:\n")
          #display a table
          print('Degree Level\t|\tDegree Type')
          print('---------------------------------')
          print('Bachelor\t|\t' + ', '.join(DEGREE_TYPE['Bachelor']))
          print('Associate\t|\t' + ', '.join(DEGREE_TYPE['Associate']))
          print('Certificate\t|\t' + ', '.join(DEGREE_TYPE['Certificate']))
          print('')
          #let the user correct the input
          recordDict['degreeType'] = input("Degree Type: ")
      #honor type field
        while recordDict['honorType'] == '' or recordDict['honorType'] == ' ':
            #let the user correct the input
            recordDict['honorType'] = input("Honors Earned: ")      
 
    #exit input validation loops


    #return dict that has passed inspection / been updated
    return recordDict


#checkNameCapitalization() - checks the first, middle, and last recipient dict keys for capitalization
def checkNameCapitalization(recordDict):
    
    #validate name capitalization for
    # first, middle, and last

    #check first, middle, and last dict keys
    if recordDict['first'][0].isupper() == False or (recordDict['middle'] != '' and recordDict['middle'][0].isupper() == False) or recordDict['last'][0].isupper() == False:
        #display error message
        print(f'Error: {recordDict} has incorrect capitalization. Please correct the following:\n')
        #enter loop
        #correct first name
        while recordDict['first'][0].isupper() == False:
            #let the user correct the input
            recordDict['first'] = input(f'First Name | Currently: {recordDict['first']}\tCorrected: ')
            #correct middle name
        while recordDict['middle'] != '' and recordDict['middle'][0].isupper() == False:
            #let the user correct the input
            recordDict['middle'] = input(f'Middle Name | Currently: {recordDict['middle']}\tCorrected: ')
            #correct last name
        while recordDict['last'][0].isupper() == False:
            #let the user correct the input
            recordDict['last'] = input(f'Last Name | Currently: {recordDict['last']}\tCorrected: ')
        
        #exit loops
        
    #return dict that has passed inspection / been updated
    return recordDict


#validateDegreeTypes() - get recordDict from validateRecordDict() and checks for valid degree types
def validateDegreeTypes(recordDict):
    #see if the recipeints degree type is in the recognized master list of degree types
    #if the degree type input is not in any of dict lists (which is why we use AND here), then we enter the loop
  while recordDict['degreeType'] not in DEGREE_TYPE['Bachelor'] and recordDict['degreeType'] not in DEGREE_TYPE['Associate'] and recordDict['degreeType'] not in DEGREE_TYPE['Certificate']: 
      print(f"{recordDict['degreeType']} is not currently offered at Eastern Arizona College.\n") 
      print('Please choose one of the following:')
