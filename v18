"""

Program to sort and format graduate recipients for a commencement program. 

"""

#Honor Type Symbol Constants

NO_HONORS = ' '
HONORS = '*'
HIGH_HONORS ='†'
HIGHEST_HONORS = '‡'

#constant list used as an input validation standard
HONOR_TYPE = ['No Honors', 'Honors', 'High Honors', 'Highest Honors']

#how many fields each record must have
RECORD_FIELDS_COUNT = 5

#degree level constants so if we ever need to add a new degree level or degree type
# we can do it in one place

DEGREE_LEVEL = ['Bachelor', 'Associate', 'Certificate']

#constant list used as an input validation standard
DEGREE_TYPE = {'Bachelor': ['BA', 'BS'], 
               'Associate': ['AA', 'AAS','ABus', 'AGS','AS'],
               'Certificate': ['Certificate']}


#main function - run program
def main():
    displayTitle()
    
    #control the menu = 'direct traffic'
    #set the initial start variable condition value to 0 so it will always run when it first boots up
    choice = '0'
    
    #determine if the user wants to quit the program
    while choice != '2':
        #display the menu and get a return value for choice
        choice = displayMenu()
        if choice == '1':
            #start collecting recipient records and return the list
            recipientList = getRecipientRecords()
            #pass the list on to be processed and reformatted
            formattedRecipientList = formatList(recipientList)
            
            #print the reformatted list
            for line in formattedRecipientList:
                print(line)
            
    print("\nThanks for using the Recipient Formatter. \nHave a good day!\n")


