      print('Associate:\t' + ', '.join(DEGREE_TYPE['Associate']))
      print('Certificate:\t' + ', '.join(DEGREE_TYPE['Certificate']))
      print('')
      recordDict['degreeType'] = input('Enter Degree Type: ')
          
  return recordDict

#validateHonorTypes() - checks for valid honor types
def validateHonorTypes(recordDict):
    #see if the recipeints honor type is in the recognized master list of degree types
    #if the degree type input is not in any of dict lists (which is why we use AND here), then we enter the loop
  while recordDict['honorType'] not in HONOR_TYPE: 
      print(f"{recordDict['honorType']} is not a valid honor type.") 
      print(f'Please choose one of the following:\n{HONOR_TYPE}')
      recordDict['honorType'] = input('Update Honor Type: ')
          
  return recordDict


#formatList function - begins formatting and sorting by utilizing nested loops
def formatList(records):
    
    #create an empty list
    formattedList =[]
    
    #get a unique list of degrees to use in the formatting loops
    uniqueDegreeList = getUniqueDegreeTypes(records)
   
    #use nested loops to sort by
        #degree level
            #degree type
                #recipients
                    #find recipients that match degree type
                    #sort those recipients
                    #print those recipients
    
    #outer loop - degree level --  ex. Bachelor
    #level automatically has zero value, it changes value by going through the degree level constant list
    for level in DEGREE_LEVEL:

        #inner loop 1 = degree type -- ex. BS
        #the value that the level variable gained in the outer loop is passed as a key to the degree type constant dictionary of lists in inner loop 1
        #the variable degreeType automatically has no value, it changes value by going through the degree types stored in the degree types constant dictionary lists accessed through the level variable key
        
        for degreeType in uniqueDegreeList[level]:
            #pass degreeType to get the proper heading and store the returned value as heading
            heading = getFullDegreeHeading(degreeType)
            formattedList.append(heading)

            #create an empty list of recipients for the current degree type, which will be filled in the next loop
            degreeRecipients = []

            #inner loop 2.1 = get the recipients
            for recipient in records:
                #scan through the list to find items that match the criteria given from Inner Loop 1's degreeType variable
                if recipient.get('degreeType') == degreeType:
                    #add matches to the current degree's list
                    degreeRecipients.append(recipient)

            #got all of the recipients that match the criteria? NOW sort them by last name
            sortedDegreeRecipients = sortRecipientList(degreeRecipients)

            #inner loop 2.2 = add the sorted list of selected recipients to the final formatted list ONCE
            for recipient in sortedDegreeRecipients:
                #get the full formatted name for each recipient
                recipient = (f'{getHonorSymbol(recipient)} {getFullName(recipient)}')
                
                #add that formatted name to the master formatted list
                formattedList.append(f'\t{recipient}')           
    #after ALL loops have concluded, return list to main()          
    return formattedList


#sortDegreeHeadings function - receive multiple degree types and produce a sorted list with no duplicates
def getUniqueDegreeTypes(recipientList):
    
    #empty degree lists to be filled in through iteration
    certificates = []
    associateDegrees = []
    bachelorDegrees = []
    
    #identify the degree types and add to list(s)
    #iterate through each recipient in the list
    for recipient in recipientList:
        #check if the value currently exists in the list or not
        #bachelor
        if recipient['degreeType'][0] == 'b' or recipient['degreeType'][0] == 'B':
            #detect and prevent adding of duplicates
            if recipient['degreeType'] not in bachelorDegrees:
                bachelorDegrees.append(recipient['degreeType'])
        #associate
        elif recipient['degreeType'][0] == 'a' or recipient['degreeType'][0] == 'A':
            #detect and prevent adding of duplicates
            if recipient['degreeType'] not in associateDegrees:
                associateDegrees.append(recipient['degreeType'])
        #certificate
        elif recipient['degreeType'][0] == 'c' or recipient['degreeType'][0] == 'C':
            #detect and prevent adding of duplicates
            if recipient['degreeType'] not in certificates:
                certificates.append(recipient['degreeType'])
    
    #exit the loop

    #sort each degree level lists alphabetically
    bachelorDegrees.sort()
    associateDegrees.sort()
    
    #certificates don't need to be sorted as there is only one type
    
    #add sorted lists to master dict list
    uniqueDegreeDict = dict(
        #assign keys to list indexes
        Bachelor = bachelorDegrees,
        Associate = associateDegrees,
        Certificate = certificates)

    #return sorted unique list to formatlist() to use in runs
    #so that only provided values are used instead of all possible values
    return uniqueDegreeDict


#getFullDegreeHeading function - receive one degree type and convert it
def getFullDegreeHeading(degreeType):

    #bachelor's ['BA', 'BS']
    if degreeType == 'BA':
        heading = 'Bachelor of Arts'
        return heading
    elif degreeType == 'BS':
        heading = 'Bachelor of Science'
        return heading

    #associate's ['AA', 'AAS','ABus', 'AGS','AS'],
    elif degreeType == 'AA':
        heading = 'Associate of Arts'
        return heading
    elif degreeType == 'AAS':
        heading = 'Associate of Applied Science'
        return heading
    elif degreeType == 'ABus' or degreeType == 'Abus':
        heading = 'Associate of Business'
        return heading
    elif degreeType == 'AGS':
        heading = 'Associate of General Studies'
        return heading
    elif degreeType == 'AS':
        heading = 'Associate of Science'
        return heading

    #certificate
    elif degreeType == 'Certificate':
        heading = 'Certificates'
        return heading

    #unrecognized degree
    else:
        print('Degree Type Not Recognized')

#sortSDegreeRecipients - Sort recipients in a list by last name and then return the list
def sortRecipientList(degreeRecipients):
    
    #sort the recipients in the dictioanry list by last name
    sortedDegreeRecipients = sorted(degreeRecipients, key = lambda d: d['last'])
    
    return sortedDegreeRecipients


#fullName function - concatenate first, middle, and last name together
def getFullName(record):
    
    #concatenate first, middle, and last name into a full name
    if record['middle'] == ' ':
        fullName = record['first'] + ' ' + record['last']
    else:
        fullName = record['first'] + ' ' + record['middle'] + ' ' + record['last']
    
    return fullName


#getHonorSymbol function - determine what honor symbol the recipient gets
def getHonorSymbol(recipient):
    
    #find what honor symbol matches the given honor type
    
    if recipient['honorType'] == 'No Honors' or recipient['honorType'] == 'no honors':
        honorType = NO_HONORS
    elif recipient['honorType'] == 'Honors' or recipient['honorType'] == 'honors':
        honorType = HONORS
    elif recipient['honorType'] == 'High Honors' or recipient['honorType'] == 'high honors':
        honorType = HIGH_HONORS
    elif recipient['honorType'] == 'Highest Honors' or recipient['honorType'] == 'highest honors':
        honorType = HIGHEST_HONORS

    #return appropriate honor symbol
    return honorType
    
    
